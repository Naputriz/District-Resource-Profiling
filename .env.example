# ==============================================================================
# DISTRICT RESOURCE PROFILING (DRP) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Project & Environment
PROJECT_NAME="District Resource Profiling"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database (PostgreSQL 16 + PostGIS 3.4 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=district_profiling
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_spatial_dev

# Caching Layer (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Spatial Engine Settings (DKI Jakarta SRID)
DEFAULT_SRID=4326               # WGS 84 (GPS standard coordinates)
PROJECTED_SRID=32748           # UTM Zone 48S (Metrik untuk akurasi jarak & luas DKI Jakarta)

# AI & LLM Inference (Local Ollama Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:14b

# Data Sources & APIs
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
JAKARTA_BPS_DATA_DIR=./pipeline/data/bps
GEOJSON_BOUNDARIES_DIR=./pipeline/data/geojson

# Urban Simulation Sandbox Settings
SIMULATION_MAX_POPULATION_DELTA=100000
SIMULATION_CACHE_TTL=3600

